# Copy to .env and fill in. Never commit .env.
# SEC requires a descriptive User-Agent with a contact email, e.g. "lakehouse-portfolio you@example.com"
SEC_USER_AGENT=

# Object storage (SeaweedFS S3) — laptop-only credentials
S3_ACCESS_KEY=lakehouse
S3_SECRET_KEY=lakehouse-secret
S3_REGION=us-east-1

# Postgres
POSTGRES_PASSWORD=postgres
ICEBERG_CATALOG_PASSWORD=iceberg
ETL_WRITER_PASSWORD=etl_writer
DBT_PASSWORD=dbt
GRAFANA_RO_PASSWORD=grafana_ro
AGENT_RO_PASSWORD=agent_ro
AGENT_RW_PASSWORD=agent_rw

# Delayed equity feed (minutes). 10 mimics a free-tier feed; raise it to simulate a slower one.
QUOTE_DELAY_MINUTES=10

# Optional: Slack/Teams/Discord webhook for failure notifications
ALERT_WEBHOOK_URL=
