  {
   "id": 7,
   "title": "Intraday 60-minute volatility (crypto 24/7, equities delayed >= 10 min)",
   "type": "timeseries",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "warehouse"
   },
   "gridPos": {
    "x": 12,
    "y": 25,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "warehouse"
     },
     "rawSql": "select minute as time, ticker as metric, vol_60m from marts.fct_intraday_volatility where $__timeFilter(minute) and vol_60m is not null order by 1",
