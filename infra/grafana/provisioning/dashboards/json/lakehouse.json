     "rawSql": "select ticker_a, ticker_b, round(corr_60d::numeric, 2) as corr_60d from marts.fct_correlation_60d where trade_date = (select max(trade_date) from marts.fct_correlation_60d) and corr_60d is not null order by corr_60d desc",
     "format": "table",
     "rawQuery": true,
