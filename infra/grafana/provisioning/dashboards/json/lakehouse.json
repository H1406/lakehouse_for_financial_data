  {
   "id": 3,
   "title": "Volatility regime: weekly average 20d vol (ticker x week)",
   "type": "status-history",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "warehouse"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "warehouse"
     },
     "rawSql": "select date_trunc('week', trade_date)::timestamp as time, ticker as metric, avg(vol_20d) as vol from marts.fct_rolling_volatility where $__timeFilter(trade_date::timestamp) and vol_20d is not null group by 1, 2 order by 1",
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "continuous-GrYlRd"
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "title": "Drawdown from running high",
   "type": "timeseries",
   "datasource": {
    "type": "grafana-postgresql-datasource",
