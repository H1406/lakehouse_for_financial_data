  {
   "id": 12,
   "title": "Latest dbt results (non-pass first)",
   "type": "table",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "warehouse"
   },
   "gridPos": {
    "x": 0,
    "y": 49,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "warehouse"
     },
     "rawSql": "select unique_id, resource_type, status, failures, execution_time_s, generated_at from ops.dbt_result where invocation_id = (select invocation_id from ops.dbt_result order by generated_at desc limit 1) order by (status in ('pass', 'success')), unique_id",
