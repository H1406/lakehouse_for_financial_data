   },
   "gridPos": {
    "x": 12,
    "y": 41,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "warehouse"
     },
     "rawSql": "select date_trunc('minute', written_at) as time, query_name as metric, max(max_event_lag_seconds) as lag_s from ops.stream_metrics where $__timeFilter(written_at) group by 1, 2 order by 1",
