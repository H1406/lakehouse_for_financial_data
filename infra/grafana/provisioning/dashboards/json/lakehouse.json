     "rawSql": "select date_trunc('minute', written_at) as time, query_name as metric, sum(events) as events from ops.stream_metrics where $__timeFilter(written_at) group by 1, 2 order by 1",
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {},
