  {
   "id": 5,
   "title": "Latest 20d vol z-score (alert > 3)",
   "type": "bargauge",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "warehouse"
   },
   "gridPos": {
    "x": 12,
    "y": 17,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "warehouse"
     },
     "rawSql": "select ticker, round(vol_20d_zscore::numeric, 2) as z from marts.fct_rolling_volatility where trade_date = (select max(trade_date) from marts.fct_rolling_volatility) and vol_20d_zscore is not null order by z desc",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "reduceOptions": {
     "values": true,
     "calcs": [],
     "fields": "/^z$/"
    }
   }
  },
  {
   "id": 6,
   "title": "60-day return correlation (latest day)",
