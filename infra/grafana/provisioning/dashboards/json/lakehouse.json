  {
   "id": 8,
   "title": "Pipeline freshness: hours since last successful load",
   "type": "table",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "warehouse"
   },
   "gridPos": {
    "x": 0,
    "y": 33,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "warehouse"
     },
     "rawSql": "select coalesce(source, dag_id) as source, entity, max(finished_at) as last_success, round((extract(epoch from now() - max(finished_at)) / 3600)::numeric, 1) as hours_ago from ops.pipeline_run where status = 'success' group by 1, 2 order by hours_ago desc",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "title": "Reconciliation (last 50 checks)",
   "type": "table",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "warehouse"
   },
   "gridPos": {
    "x": 12,
    "y": 33,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "warehouse"
     },
     "rawSql": "select checked_at, source, entity, layer_from || ' -> ' || layer_to as hop, count_from, count_to, missing, duplicates, status from ops.reconciliation order by checked_at desc limit 50",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
