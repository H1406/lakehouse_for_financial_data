{
 "uid": "lakehouse",
 "title": "Lakehouse: volatility & pipeline health",
 "schemaVersion": 41,
 "time": {
  "from": "now-1y",
  "to": "now"
 },
 "refresh": "1m",
 "tags": [
  "lakehouse"
